{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/usr/bin/env bash

set -euo pipefail

{{ template "script-foundation.sh" . }}

require_command python3 "python3 is unavailable; cannot update Slack theme state"
require_command ps "ps is unavailable; cannot safely update Slack state"
require_command awk "awk is unavailable; cannot safely update Slack state"

running_slack_pids="$(ps -eo pid=,comm= | awk '$2 == "slack" { print $1 }')"
[[ -z "${running_slack_pids}" ]] ||
  fail "Slack is running (PID(s): ${running_slack_pids//$'\n'/ }); close it and rerun chezmoi apply"

slack_state_file="${SLACK_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/Slack}/storage/root-state.json"
if [[ ! -f "${slack_state_file}" ]]; then
  printf 'No existing Slack profile found; leaving Slack unchanged.\n'
  exit 0
fi

python3 - "${slack_state_file}" <<'PY'
{{ template "atomic-json-state.py" . }}

state_path = sys.argv[1]
state, mode = read_json_object(
    state_path,
    symlink_label="Slack root state",
    read_context="Slack root state",
    object_error="error: Slack root state is not a JSON object",
)

settings = state.setdefault("settings", {})
webapp = state.setdefault("webapp", {})
teams = webapp.setdefault("teams", {}) if isinstance(webapp, dict) else None
if not isinstance(settings, dict) or not isinstance(teams, dict):
    raise SystemExit("error: Slack theme state has an unsupported shape")

changed = settings.get("userTheme") != "dark" or settings.get("systemThemeSyncEnabled") is not False
settings["userTheme"] = "dark"
settings["systemThemeSyncEnabled"] = False
for team_id, team in teams.items():
    if not isinstance(team, dict):
        raise SystemExit(f"error: Slack team state has an unsupported shape: {team_id}")
    theme = team.setdefault("theme", {})
    if not isinstance(theme, dict):
        raise SystemExit(f"error: Slack theme state has an unsupported shape: {team_id}")
    changed |= theme.get("titlebarBackground") != "#282A36"
    changed |= theme.get("titlebarTextColor") != "#F8F8F2"
    theme["titlebarBackground"] = "#282A36"
    theme["titlebarTextColor"] = "#F8F8F2"

if not changed:
    print(f"Slack already uses Dracula dark mode: {state_path}")
    raise SystemExit(0)

write_json_object(
    state_path,
    state,
    mode=mode,
    prefix=".root-state.chezmoi-",
    update_context="Slack root state",
    indent=2,
)
print(f"Configured Dracula dark mode in Slack: {state_path}")
PY
{{- end }}
