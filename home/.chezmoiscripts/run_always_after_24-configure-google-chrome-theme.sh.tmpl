{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/usr/bin/env bash

set -euo pipefail

{{ template "script-foundation.sh" . }}

chrome_theme_id="gfapcejdoghpoidkfodoiiffaaibpaem"
chrome_config_dir="${CHROME_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/google-chrome}"
external_extensions_dir="${CHROME_EXTERNAL_EXTENSIONS_DIR:-/opt/google/chrome/extensions}"
external_extension_file="${external_extensions_dir}/${chrome_theme_id}.json"

require_command sudo "sudo is unavailable; Chrome's supported Linux external-extension directory requires administrator access"
require_command python3 "python3 is unavailable; cannot update Chrome profile preferences"
require_command ps "ps is unavailable; cannot safely update Chrome profile preferences"
require_command awk "awk is unavailable; cannot safely update Chrome profile preferences"

if ! command -v google-chrome >/dev/null 2>&1 && ! command -v google-chrome-stable >/dev/null 2>&1; then
  fail "Google Chrome Stable is unavailable; install it before configuring the Dracula theme"
fi

running_chrome_pids="$(ps -eo pid=,comm= | awk '$2 == "google-chrome" || $2 == "google-chrome-stable" || $2 == "chrome" { print $1 }')"
if [[ -n "${running_chrome_pids}" ]]; then
  fail "Google Chrome is running (PID(s): ${running_chrome_pids//$'\n'/ }); close it and rerun chezmoi apply"
fi

temporary_extension_file="$(mktemp)"
trap 'rm -f "${temporary_extension_file}"' EXIT
cat >"${temporary_extension_file}" <<EOF
{
  "external_update_url": "https://clients2.google.com/service/update2/crx"
}
EOF

sudo install -d -m 0755 "${external_extensions_dir}"
if ! sudo cmp -s "${temporary_extension_file}" "${external_extension_file}"; then
  sudo install -m 0644 "${temporary_extension_file}" "${external_extension_file}"
  printf 'Configured automatic installation of Dracula Chrome theme.\n'
else
  printf 'Dracula Chrome theme installation is already configured.\n'
fi

profile_count=0
shopt -s nullglob
preference_files=(
  "${chrome_config_dir}/Default/Preferences"
  "${chrome_config_dir}"/Profile\ */Preferences
)

for preferences in "${preference_files[@]}"; do
  profile_name="$(basename "$(dirname "${preferences}")")"
  case "${profile_name}" in
    "System Profile"|"Guest Profile")
      continue
      ;;
  esac

  python3 - "${preferences}" "${chrome_theme_id}" <<'PY'
import sys
{{ template "atomic-json-state.py" . }}

preferences_path, theme_id = sys.argv[1:]
preferences, preferences_mode = read_json_object(
    preferences_path,
    symlink_label="Chrome preferences file",
    read_context=f"Chrome preferences {preferences_path}",
    object_error=f"error: Chrome preferences are not a JSON object: {preferences_path}",
)

extensions = preferences.setdefault("extensions", {})
if not isinstance(extensions, dict):
    raise SystemExit(f"error: Chrome extensions preferences have an unsupported shape: {preferences_path}")

theme = extensions.setdefault("theme", {})
if not isinstance(theme, dict):
    raise SystemExit(f"error: Chrome theme preferences have an unsupported shape: {preferences_path}")

changed = theme.get("id") != theme_id or theme.get("system_theme") != 0
theme["id"] = theme_id
theme["system_theme"] = 0

if not changed:
    print(f"Chrome profile already uses Dracula: {preferences_path}")
    raise SystemExit(0)

write_json_object(
    preferences_path,
    preferences,
    mode=preferences_mode,
    prefix=".Preferences.chezmoi-",
    update_context=f"Chrome preferences {preferences_path}",
    separators=(",", ":"),
)

print(f"Configured Dracula Chrome theme in {preferences_path}")

PY
  profile_count=$((profile_count + 1))
done

if (( profile_count == 0 )); then
  printf 'No existing Chrome profile preferences found; the theme will install automatically when Chrome creates its first profile.\n'
fi
{{- end }}
