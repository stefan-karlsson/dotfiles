{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/usr/bin/env bash

set -euo pipefail

{{ template "shell-foundation.sh" . }}
{{ template "artifact-fetch-foundation.sh" . }}

require_command curl "curl is unavailable; cannot install the managed .NET SDK feature band"

sdk_version={{ .packages.dotnet.sdk_version | quote }}
dotnet_root="${HOME}/.dotnet"
dotnet_install_script="$(artifact_scratch_dir)/dotnet-install.sh"

# Microsoft publishes no checksum for the installer script itself; the SDK it
# fetches is verified by the installer, and the installed version is asserted below.
fetch_verified_artifact \
  --url https://dot.net/v1/dotnet-install.sh \
  --dest "${dotnet_install_script}" \
  --label 'the official .NET install script'
chmod 0700 "${dotnet_install_script}"

"${dotnet_install_script}" \
  --version "${sdk_version}" \
  --install-dir "${dotnet_root}" \
  --no-path

[[ -x "${dotnet_root}/dotnet" ]] || {
  printf 'error: .NET SDK %s was not installed in %s\n' "${sdk_version}" "${dotnet_root}" >&2
  exit 1
}

install -d -m 0755 "${HOME}/.local/bin"
ln -sfn "${dotnet_root}/dotnet" "${HOME}/.local/bin/dotnet"
export DOTNET_ROOT="${dotnet_root}"
export PATH="${dotnet_root}:${PATH}"

installed_version="$(dotnet --version)"
[[ "${installed_version}" == "${sdk_version}" ]] || {
  printf 'error: expected .NET SDK %s, found %s\n' "${sdk_version}" "${installed_version}" >&2
  exit 1
}
printf '.NET SDK %s is installed for user-scoped development.\n' "${installed_version}"
{{- end }}
