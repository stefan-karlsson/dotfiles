{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/usr/bin/env bash

set -euo pipefail

{{ template "shell-foundation.sh" . }}

require_command python3 "python3 is unavailable; cannot update Obsidian theme state"
require_command git "git is unavailable; cannot install the official Dracula Obsidian theme"
require_command ps "ps is unavailable; cannot safely update Obsidian state"
require_command awk "awk is unavailable; cannot safely update Obsidian state"
git_http_options=(-c http.connectTimeout=10 -c http.lowSpeedLimit=1024 -c http.lowSpeedTime=15)

running_obsidian_pids="$(ps -eo pid=,comm= | awk '$2 == "obsidian" || $2 == "Obsidian" { print $1 }')"
[[ -z "${running_obsidian_pids}" ]] ||
  fail "Obsidian is running (PID(s): ${running_obsidian_pids//$'\n'/ }); close it and rerun chezmoi apply"

obsidian_scan_root="${OBSIDIAN_SCAN_ROOT:-$HOME}"
found_vault=0
while IFS= read -r obsidian_config_dir; do
  found_vault=1
  vault_path="${obsidian_config_dir%/.obsidian}"
  [[ -d "${vault_path}" ]] || {
    printf 'Skipping missing Obsidian vault: %s\n' "${vault_path}"
    continue
  }
  vault_config_dir="${obsidian_config_dir}"
  theme_dir="${vault_config_dir}/themes/Dracula Official"
  appearance_file="${vault_config_dir}/appearance.json"
  [[ -d "${vault_config_dir}" ]] || {
    printf 'Skipping Obsidian vault without a configuration folder: %s\n' "${vault_path}"
    continue
  }

  if [[ ! -d "${theme_dir}" ]]; then
    install -d -m 0755 "$(dirname "${theme_dir}")"
    GIT_TERMINAL_PROMPT=0 git "${git_http_options[@]}" clone --depth 1 "https://github.com/dracula/obsidian.git" "${theme_dir}"
  elif [[ ! -f "${theme_dir}/manifest.json" || ! -f "${theme_dir}/theme.css" ]]; then
    fail "Obsidian Dracula theme directory is incomplete: ${theme_dir}"
  fi

  python3 - "${appearance_file}" <<'PY'
{{ template "atomic-json-state.py" . }}

appearance_path = sys.argv[1]
appearance, mode = read_json_object(
    appearance_path,
    symlink_label="Obsidian appearance file",
    read_context="Obsidian appearance file",
    object_error=f"error: Obsidian appearance file is not a JSON object: {appearance_path}",
)
if appearance.get("cssTheme") == "Dracula Official":
    print(f"Obsidian already uses Dracula: {appearance_path}")
    raise SystemExit(0)

appearance["cssTheme"] = "Dracula Official"
write_json_object(
    appearance_path,
    appearance,
    mode=mode,
    prefix=".appearance.chezmoi-",
    update_context="Obsidian appearance file",
    indent=2,
)

print(f"Configured Dracula theme in Obsidian: {appearance_path}")
PY
done < <(
  find "${obsidian_scan_root}" \
    \( \
      -path "${obsidian_scan_root}/.cache" -o \
      -path "${obsidian_scan_root}/.config" -o \
      -path "${obsidian_scan_root}/.local" -o \
      -name .git -o \
      -name node_modules -o \
      -name .venv \
    \) -prune -o \
    -type d -name .obsidian -print
)

if (( found_vault == 0 )); then
  printf 'No Obsidian vault configuration folders found under %s; leaving Obsidian unchanged.\n' "${obsidian_scan_root}"
fi
{{- end }}
