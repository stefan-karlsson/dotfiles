{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/usr/bin/env bash

set -euo pipefail

command -v code >/dev/null 2>&1 || {
  printf 'error: VS Code is unavailable after package installation\n' >&2
  exit 1
}

extension_ids=(
  "microsoft-aspire.aspire-vscode"
  "bruno-api-client.bruno"
  "dracula-theme.theme-dracula"
  "hediet.vscode-drawio"
  "ms-vscode.cpptools-extension-pack"
  "ms-dotnettools.csdevkit"
)

for extension_id in "${extension_ids[@]}"; do
  if ! code --list-extensions 2>/dev/null | grep -Fqx "${extension_id}"; then
    node_options="${NODE_OPTIONS:-}"
    [[ -z "${node_options}" ]] || node_options+=" "
    node_options+="--no-deprecation"
    NODE_OPTIONS="${node_options}" \
      code --install-extension "${extension_id}"
  fi
done
{{- end -}}
