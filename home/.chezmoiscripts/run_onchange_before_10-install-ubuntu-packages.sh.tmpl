{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/usr/bin/env bash

set -euo pipefail

{{ template "shell-foundation.sh" . }}
{{ template "ubuntu-package-foundation.sh" . }}

[ -r /etc/os-release ] || fail "cannot identify the operating system"
# shellcheck disable=SC1091
. /etc/os-release

if [[ "${ID:-}" != "ubuntu" || "${VERSION_ID:-}" != "26.04" ]]; then
  fail "expected Ubuntu 26.04, got ${ID:-unknown} ${VERSION_ID:-unknown}"
fi

[[ "$(dpkg --print-architecture)" == "amd64" ]] ||
  fail "1Password Stable apt installation requires amd64"

for conflicting_package in docker.io docker-doc docker-compose podman-docker containerd runc; do
  package_installed "${conflicting_package}" &&
    fail "${conflicting_package} is installed; remove or migrate it before managing Docker Engine"
done

if command -v snap >/dev/null 2>&1 && snap list code >/dev/null 2>&1; then
  fail "Snap VS Code is installed; remove or migrate it before managing VS Code Stable"
fi

package_installed code-oss &&
  fail "Code - OSS is installed; remove or migrate it before managing VS Code Stable"

if command -v snap >/dev/null 2>&1 && snap list 1password >/dev/null 2>&1; then
  fail "Snap 1Password is installed; remove or migrate it before managing 1Password Stable"
fi

if command -v flatpak >/dev/null 2>&1 && flatpak info com.onepassword.OnePassword >/dev/null 2>&1; then
  fail "Flatpak 1Password is installed; remove or migrate it before managing 1Password Stable"
fi

for repository_name in "${repository_names[@]}"; do
  repository_enabled "${repository_name}" || continue
  fail_on_unmanaged_repository "${repository_name}" || exit 1
done

repository_prerequisites=()
command -v curl >/dev/null 2>&1 || repository_prerequisites+=("curl")
command -v gpg >/dev/null 2>&1 || repository_prerequisites+=("gpg")

if (( ${#repository_prerequisites[@]} > 0 )); then
  sudo apt-get update
  sudo env DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends "${repository_prerequisites[@]}"
fi

for repository_name in "${repository_names[@]}"; do
  repository_enabled "${repository_name}" || continue
  configure_repository "${repository_name}"
done

packages=(
{{- range .packages.ubuntu.apt }}
  {{ printf "%s|default" . | quote }}
{{- end }}
{{- range .packages.ubuntu.profile_apt.private }}
  {{ printf "%s|private" . | quote }}
{{- end }}
{{- range .packages.ubuntu.profile_apt.company }}
  {{ printf "%s|company" . | quote }}
{{- end }}
)

selected_packages=()
for package_spec in "${packages[@]}"; do
  IFS='|' read -r package_name package_profile <<<"${package_spec}"
  [[ "${package_profile}" == "default" || "${package_profile}" == "${profile_name}" ]] || continue
  selected_packages+=("${package_name}")
done

sudo apt-get update
sudo env DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends "${selected_packages[@]}"

if ! sudo update-alternatives --query editor | grep -Fqx "Alternative: /usr/bin/code"; then
  sudo update-alternatives --install /usr/bin/editor editor /usr/bin/code 60
fi
sudo update-alternatives --set editor /usr/bin/code
xdg-mime default code.desktop text/plain
xdg-mime default google-chrome.desktop x-scheme-handler/http
xdg-mime default google-chrome.desktop x-scheme-handler/https
xdg-mime default google-chrome.desktop text/html
xdg-mime default google-chrome.desktop application/xhtml+xml
printf 'VS Code Stable is installed. Start it with code or code .\n'
printf 'Google Chrome Stable is installed and set as the default browser.\n'
{{- end }}
