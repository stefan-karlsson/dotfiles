{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/usr/bin/env bash

set -euo pipefail

{{ template "shell-foundation.sh" . }}

profile_name={{ (get (get . "profile" | default (dict)) "name" | default "default") | quote }}
[[ "${profile_name}" == "private" ]] || exit 0

slay_cli_source="/opt/SlayZone/resources/bin/slay"
slay_cli_target="${HOME}/.local/bin/slay"
[[ -x "${slay_cli_source}" ]] ||
  fail "SlayZone CLI is unavailable at ${slay_cli_source}; launch SlayZone and install its CLI first"

install -d -m 0755 "$(dirname "${slay_cli_target}")"
if [[ -e "${slay_cli_target}" || -L "${slay_cli_target}" ]]; then
  [[ -L "${slay_cli_target}" ]] ||
    fail "${slay_cli_target} exists but is not the managed SlayZone CLI link"
  [[ "$(readlink -f "${slay_cli_target}")" == "$(readlink -f "${slay_cli_source}")" ]] ||
    fail "${slay_cli_target} points to an unmanaged SlayZone CLI"
else
  ln -s "${slay_cli_source}" "${slay_cli_target}"
fi

printf 'SlayZone CLI is available as %s (Node 24+ is provided by mise).\n' "${slay_cli_target}"
{{- end -}}
