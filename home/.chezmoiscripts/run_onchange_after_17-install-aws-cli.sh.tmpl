{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/usr/bin/env bash

set -euo pipefail

{{ template "shell-foundation.sh" . }}
{{ template "artifact-fetch-foundation.sh" . }}

{{- $tool := dict }}
{{- range .packages.ubuntu.external_tools }}
{{-   if eq .name "aws-cli" }}{{ $tool = . }}{{ end }}
{{- end }}
{{- if not $tool }}{{ fail "packages.toml declares no external tool named aws-cli" }}{{ end }}
minimum_version={{ $tool.minimum_version | quote }}
archive_url={{ $tool.url | quote }}
signature_url={{ $tool.signature_url | quote }}
expected_fingerprint={{ $tool.signature_key_fingerprint | quote }}
install_dir={{ $tool.install_dir | quote }}
bin_dir={{ $tool.bin_dir | quote }}
marker_file={{ $tool.marker_file | quote }}
key_file="${HOME}/.local/share/aws-cli/aws-cli-team.asc"

if [[ -e "${marker_file}" && -x "${install_dir}/v2/current/bin/aws" ]]; then
  installed_version="$(${install_dir}/v2/current/bin/aws --version 2>/dev/null | sed -n 's/^aws-cli\/\([^ ]*\).*/\1/p')"
  if [[ -n "${installed_version}" ]] && dpkg --compare-versions "${installed_version}" ge "${minimum_version}"; then
    printf 'AWS CLI v2 %s is already installed.\n' "${installed_version}"
    exit 0
  fi
fi

if [[ ! -e "${marker_file}" ]]; then
  [[ ! -e "${install_dir}" ]] || fail "AWS CLI is installed outside this managed setup; migrate it before continuing"
  if command -v aws >/dev/null 2>&1; then
    fail "aws resolves to an unmanaged installation; migrate it before continuing"
  fi
fi

temporary_dir="$(artifact_scratch_dir)"
fetch_verified_artifact \
  --url "${archive_url}" \
  --dest "${temporary_dir}/awscliv2.zip" \
  --label 'AWS CLI v2' \
  --signature-url "${signature_url}" \
  --key-file "${key_file}" \
  --fingerprint "${expected_fingerprint}"

unzip -q "${temporary_dir}/awscliv2.zip" -d "${temporary_dir}"
sudo "${temporary_dir}/aws/install" --update --install-dir "${install_dir}" --bin-dir "${bin_dir}"
# The installation belongs to this setup from the moment it lands. A rerun that
# rejects the version below replaces it, and reads it as this script's own work
# rather than as an unmanaged installation.
sudo install -d -m 0755 "$(dirname "${marker_file}")"
sudo touch "${marker_file}"

installed_version="$(${install_dir}/v2/current/bin/aws --version 2>/dev/null | sed -n 's/^aws-cli\/\([^ ]*\).*/\1/p')"
[[ -n "${installed_version}" ]] || fail "AWS CLI did not report a version after installation"
dpkg --compare-versions "${installed_version}" ge "${minimum_version}" ||
  fail "AWS CLI installed version ${installed_version}, older than the supported ${minimum_version}"
printf 'AWS CLI v2 %s is installed.\n' "${installed_version}"
{{- end -}}
