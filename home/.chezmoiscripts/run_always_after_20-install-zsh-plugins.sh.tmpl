{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/usr/bin/env bash

set -euo pipefail

{{ template "shell-foundation.sh" . }}

require_command git "git is unavailable; cannot install the managed Zsh plugins"

plugin_root="${XDG_DATA_HOME:-$HOME/.local/share}/{{ .zsh_plugins.root }}"

ensure_checkout() {
  local name="$1"
  local repository="$2"
  local commit="$3"
  local target="${plugin_root}/${name}"
  local current_commit=""

  if [[ -L "${target}" ]]; then
    fail "${target} is a symbolic link; refusing to manage it as a Zsh plugin checkout"
  fi
  if [[ -e "${target}" && ! -d "${target}/.git" ]]; then
    fail "${target} exists but is not the managed ${name} checkout"
  fi

  if [[ -d "${target}/.git" ]]; then
    [[ "$(git -C "${target}" config --get remote.origin.url)" == "${repository}" ]] ||
      fail "${target} is not the managed ${name} checkout"
    [[ -z "$(git -C "${target}" status --porcelain --untracked-files=all --ignored)" ]] ||
      fail "${target} has local changes; commit or remove them before updating ${name}"
  else
    install -d -m 0755 "${plugin_root}"
    git clone --depth=1 --no-checkout "${repository}" "${target}"
  fi

  current_commit="$(git -C "${target}" rev-parse HEAD 2>/dev/null || true)"
  if [[ "${current_commit}" != "${commit}" ]]; then
    if ! git -C "${target}" cat-file -e "${commit}^{commit}" 2>/dev/null; then
      git -C "${target}" fetch --depth=1 origin "${commit}"
    fi
    git -C "${target}" checkout --detach --force "${commit}"
  elif git -C "${target}" symbolic-ref --quiet --short HEAD >/dev/null 2>&1; then
    git -C "${target}" checkout --detach --force "${commit}"
  fi

  [[ "$(git -C "${target}" rev-parse HEAD)" == "${commit}" ]] ||
    fail "${name} checkout did not reach pinned commit ${commit}"
}

{{- range .zsh_plugins.plugins }}
ensure_checkout {{ .name | quote }} {{ .repository | quote }} {{ .commit | quote }}
{{- end }}
{{- end }}
