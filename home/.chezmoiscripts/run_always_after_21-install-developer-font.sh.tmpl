{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/usr/bin/env bash
set -euo pipefail

{{ template "shell-foundation.sh" . }}
{{ template "artifact-fetch-foundation.sh" . }}

font_dir="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/FiraCodeNerdFontMono"
font_archive_url="https://github.com/ryanoasis/nerd-fonts/releases/latest/download/FiraCode.zip"

shopt -s nullglob
fonts=("${font_dir}"/FiraCodeNerdFontMono-*.ttf)
if (( ${#fonts[@]} > 0 )); then
  printf 'FiraCode Nerd Font Mono is already installed; keeping the managed font files.\n'
  exit 0
fi

scratch_dir="$(artifact_scratch_dir)"
fetch_verified_artifact \
  --url "${font_archive_url}" \
  --dest "${scratch_dir}/FiraCode.zip" \
  --label 'FiraCode Nerd Font Mono'
unzip -q "${scratch_dir}/FiraCode.zip" 'FiraCodeNerdFontMono-*.ttf' -d "${scratch_dir}/fonts"

fonts=("${scratch_dir}"/fonts/FiraCodeNerdFontMono-*.ttf)
(( ${#fonts[@]} > 0 )) ||
  fail "the Nerd Fonts archive contains no FiraCode Nerd Font Mono files"

install -d -m 0755 "${font_dir}"
install -m 0644 "${fonts[@]}" "${font_dir}/"
fc-cache -f "${font_dir}"
{{- end }}
