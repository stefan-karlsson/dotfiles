{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/usr/bin/env bash

set -euo pipefail

{{ template "shell-foundation.sh" . }}
{{ template "ubuntu-package-foundation.sh" . }}
{{ template "artifact-fetch-foundation.sh" . }}

[ -r /etc/os-release ] || fail "cannot identify the operating system"
# shellcheck disable=SC1091
. /etc/os-release
[[ "${ID:-}" == "ubuntu" && "${VERSION_ID:-}" == "26.04" ]] ||
  fail "expected Ubuntu 26.04, got ${ID:-unknown} ${VERSION_ID:-unknown}"
[[ "$(dpkg --print-architecture)" == "amd64" ]] ||
  fail "direct Ubuntu .deb artifacts are managed only for amd64"

temporary_dir="$(artifact_scratch_dir)"
# apt drops to the _apt account to read the staged .deb, so it needs to traverse here.
chmod 0755 "${temporary_dir}"

artifacts=(
{{- range .packages.ubuntu.deb_artifacts }}
  {{ printf "%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s" .name .label .package_name .version .url .sha256 .marker_file .snap_name .flatpak_id (get . "command_name" | default "") (get . "profile" | default "default") (get . "signature_url" | default "") (get . "signature_key_url" | default "") (get . "signature_key_fingerprint" | default "") | quote }}
{{- end }}
)

for artifact in "${artifacts[@]}"; do
  IFS='|' read -r name label package_name expected_version url expected_sha256 marker_file \
    snap_name flatpak_id command_name artifact_profile \
    signature_url signature_key_url signature_key_fingerprint <<<"${artifact}"

  [[ "${artifact_profile}" == "default" || "${artifact_profile}" == "${profile_name}" ]] || continue

  if [[ -n "${snap_name}" ]] && command -v snap >/dev/null 2>&1 && snap list "${snap_name}" >/dev/null 2>&1; then
    fail "${label} is installed through Snap; remove or migrate it before managing the official .deb"
  fi
  if [[ -n "${flatpak_id}" ]] && command -v flatpak >/dev/null 2>&1 && flatpak info "${flatpak_id}" >/dev/null 2>&1; then
    fail "${label} is installed through Flatpak; remove or migrate it before managing the official .deb"
  fi
  if [[ -n "${command_name}" ]] && command -v "${command_name}" >/dev/null 2>&1; then
    command_path="$(command -v "${command_name}")"
    command_owner="$(dpkg-query -S "${command_path}" 2>/dev/null || true)"
    command_owner="${command_owner%%:*}"
    [[ "${command_owner}" == "${package_name}" ]] ||
      fail "${label} resolves to an unmanaged command; migrate it before continuing"
  fi

  if dpkg-query -W -f='${db:Status-Status}' "${package_name}" 2>/dev/null | grep -Fqx installed; then
    [[ -e "${marker_file}" ]] ||
      fail "${label} is installed outside this managed setup; migrate it before continuing"
    installed_version="$(dpkg-query -W -f='${Version}' "${package_name}")"
    if dpkg --compare-versions "${installed_version}" ge "${expected_version}"; then
      printf '%s %s is already installed; keeping version %s.\n' "${label}" "${expected_version}" "${installed_version}"
      continue
    fi
  fi

  if package_installed "${package_name}" && package_has_running_process "${package_name}"; then
    printf 'warning: %s is running; skipping its update until it is closed\n' "${label}" >&2
    continue
  fi

  artifact_path="${temporary_dir}/${name}.deb"
  printf 'Installing %s %s from the official vendor URL\n' "${label}" "${expected_version}"

  # A vendor that signs its package and publishes no checksum is verified against
  # its own signing key, fetched here and admitted on the fingerprint the manifest
  # pins, the way the managed apt channels admit theirs.
  verification_options=(--sha256 "${expected_sha256}")
  if [[ -n "${signature_url}" ]]; then
    signing_key_path="${temporary_dir}/${name}-signing-key.asc"
    fetch_artifact_text --url "${signature_key_url}" >"${signing_key_path}"
    verification_options+=(
      --signature-url "${signature_url}"
      --key-file "${signing_key_path}"
      --fingerprint "${signature_key_fingerprint}"
    )
  fi

  fetch_verified_artifact \
    --url "${url}" \
    --dest "${artifact_path}" \
    --label "${label}" \
    "${verification_options[@]}"

  downloaded_package_name="$(dpkg-deb -f "${artifact_path}" Package 2>/dev/null || true)"
  [[ "${downloaded_package_name}" == "${package_name}" ]] ||
    fail "${label} manifest expects package ${package_name}, but the vendor artifact declares ${downloaded_package_name:-unknown}"

  sudo env DEBIAN_FRONTEND=noninteractive apt-get install --yes "${artifact_path}"
  installed_version="$(dpkg-query -W -f='${Version}' "${package_name}" 2>/dev/null || true)"
  [[ -n "${installed_version}" ]] || fail "${label} did not install package ${package_name}"
  dpkg --compare-versions "${installed_version}" ge "${expected_version}" ||
    fail "${label} installed version ${installed_version}, expected at least ${expected_version}"

  sudo install -d -m 0755 "$(dirname "${marker_file}")"
  sudo touch "${marker_file}"
done
{{- end -}}
