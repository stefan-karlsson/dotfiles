{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash

set -euo pipefail

{{ template "shell-foundation.sh" . }}
{{ template "artifact-fetch-foundation.sh" . }}

export PATH="$HOME/.local/bin:$PATH"
# Codex publishes neither a checksum nor a signature for its installer, so it is
# trusted on its official HTTPS URL alone and executed straight from the response.
CODEX_RELEASE={{ .tools.codex.version | quote }} \
CODEX_NON_INTERACTIVE=1 \
CODEX_INSTALL_DIR="$HOME/.local/bin" \
  timeout --signal=TERM 300s \
    sh -c "$(fetch_artifact_text --url https://chatgpt.com/codex/install.sh)"
{{- end }}
