{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/usr/bin/env bash

set -euo pipefail

{{ template "shell-foundation.sh" . }}
{{ template "gnome-settings-foundation.sh" . }}
require_gnome_session

require_command curl "curl is required to install GNOME Shell extensions"
require_command jq "jq is required to select compatible GNOME Shell extension releases"
require_command gnome-shell "gnome-shell is required to install GNOME Shell extensions"
require_command gnome-extensions "gnome-extensions is required to install GNOME Shell extensions"
require_command gsettings "gsettings is required to enable GNOME Shell extensions"

shell_version="$(gnome-shell --version | sed -n 's/.* \([0-9][0-9.]*\)$/\1/p')"
[[ -n "${shell_version}" ]] || fail "could not determine the GNOME Shell version"

shell_components="$(jq -cn --arg version "${shell_version}" '$version | split(".") | map(tonumber)')"
extension_root="${XDG_DATA_HOME:-$HOME/.local/share}/gnome-shell/extensions"
download_dir="$(mktemp -d "${TMPDIR:-/tmp}/chezmoi-gnome-extensions.XXXXXX")"
trap 'rm -rf "${download_dir}"' EXIT
curl_options=(
  --connect-timeout 10
  --max-time 60
  --speed-limit 1024
  --speed-time 15
  --retry 3
  --retry-delay 2
  --retry-all-errors
)

fetch_json() {
  curl "${curl_options[@]}" -fsSL -H 'Accept: application/json' "$1"
}

compatible_version() {
  local uuid="$1"
  local response next page_version best=""
  local page=1
  local versions_url="https://extensions.gnome.org/api/v1/extensions/${uuid}/versions/?page=${page}&page_size=100"

  while [[ -n "${versions_url}" ]]; do
    response="$(fetch_json "${versions_url}")" ||
      fail "could not query official releases for ${uuid} (GNOME Shell ${shell_version})"

    page_version="$(jq -r --argjson shell "${shell_components}" '
      def matches($supported):
        if ($supported | type) == "object" then
          (($supported.major // -1) == -1 or ($supported.major // -1) == ($shell[0] // -1)) and
          (($supported.minor // -1) == -1 or ($supported.minor // -1) == ($shell[1] // -1)) and
          (($supported.patch // -1) == -1 or ($supported.patch // -1) == ($shell[2] // -1))
        elif ($supported | type) == "array" then
          (($supported[0] // -1) == -1 or ($supported[0] // -1) == ($shell[0] // -1)) and
          (($supported[1] // -1) == -1 or ($supported[1] // -1) == ($shell[1] // -1)) and
          (($supported[2] // -1) == -1 or ($supported[2] // -1) == ($shell[2] // -1))
        else false end;
      [.results[]?
       | select(.status == 3 or .status == "active")
       | select(any(.shell_versions[]?; matches(.)))
       | .version]
      | if length == 0 then empty else max end
    ' <<<"${response}")"

    if [[ -n "${page_version}" && ( -z "${best}" || "${page_version}" -gt "${best}" ) ]]; then
      best="${page_version}"
    fi

    next="$(jq -r '.next // empty' <<<"${response}")"
    if [[ -z "${next}" ]]; then
      versions_url=""
    else
      versions_url="${next}"
    fi
  done

  [[ -n "${best}" ]] ||
    fail "no active official release of ${uuid} supports GNOME Shell ${shell_version}"
  printf '%s\n' "${best}"
}

install_extension() {
  local uuid="$1"
  local name="$2"
  local latest_version installed_version download_url archive

  latest_version="$(compatible_version "${uuid}")"
  installed_version=0
  if [[ -r "${extension_root}/${uuid}/metadata.json" ]]; then
    installed_version="$(jq -r '.version // 0' "${extension_root}/${uuid}/metadata.json" 2>/dev/null || printf '0')"
  fi

  if [[ "${installed_version}" =~ ^[0-9]+$ ]] && (( installed_version < latest_version )); then
    download_url="https://extensions.gnome.org/api/v1/extensions/${uuid}/versions/${latest_version}/?format=zip"
    archive="${download_dir}/${uuid}.zip"
    printf 'Installing %s v%s for GNOME Shell %s\n' "${name}" "${latest_version}" "${shell_version}"
    curl "${curl_options[@]}" -fL -H 'Accept: application/zip' "${download_url}" -o "${archive}" ||
      fail "could not download the official ${name} release v${latest_version}"
    gnome-extensions install --force "${archive}" ||
      fail "gnome-extensions could not install ${name} v${latest_version}"
  elif [[ ! "${installed_version}" =~ ^[0-9]+$ ]]; then
    fail "installed ${name} has an invalid metadata version"
  else
    printf '%s v%s is already installed for GNOME Shell %s\n' "${name}" "${installed_version}" "${shell_version}"
  fi

  enable_extension "${uuid}" "${name}"
}

enable_extension() {
  local uuid="$1"
  local name="$2"

  if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
    local enabled_extensions
    enabled_extensions="$(gsettings get org.gnome.shell enabled-extensions)" ||
      fail "could not read GNOME's enabled extension list while enabling ${name}"
    if [[ "${enabled_extensions}" != *"'${uuid}'"* ]]; then
      if [[ "${enabled_extensions}" == '@as []' ]]; then
        enabled_extensions="['${uuid}']"
      elif [[ "${enabled_extensions}" == \[*\] ]]; then
        enabled_extensions="${enabled_extensions%]}"
        enabled_extensions+=", '${uuid}']"
      else
        fail "GNOME returned an unexpected enabled extension list while enabling ${name}"
      fi
      gsettings set org.gnome.shell enabled-extensions "${enabled_extensions}" ||
        fail "could not persistently enable ${name}; log out and in once, then run chezmoi apply again"
    fi
  else
    printf 'warning: no GNOME user session bus; %s was installed but not enabled\n' "${name}" >&2
  fi
}

disable_extension() {
  local uuid="$1"
  local name="$2"
  local inspect_state="${3:-false}"

  if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
    local enabled_extensions
    enabled_extensions="$(gsettings get org.gnome.shell enabled-extensions)" ||
      fail "could not read GNOME's enabled extension list while disabling ${name}"
    local should_disable=false
    if [[ "${enabled_extensions}" == *"'${uuid}'"* ]]; then
      should_disable=true
    elif [[ "${inspect_state}" == true ]]; then
      local extension_state
      extension_state="$(gnome-extensions info "${uuid}" 2>/dev/null | sed -n 's/^[[:space:]]*State: //p' || true)"
      case "${extension_state}" in
        ACTIVE|ERROR)
          should_disable=true
          ;;
      esac
    fi
    if [[ "${should_disable}" == true ]]; then
      gnome-extensions disable "${uuid}" ||
        fail "could not disable conflicting ${name}; log out and in once, then run chezmoi apply again"
      if [[ "${enabled_extensions}" == *"'${uuid}'"* ]]; then
        local filtered_extensions
        filtered_extensions="$(sed \
          -e "s/, '${uuid}'//" \
          -e "s/'${uuid}', //" \
          -e "s/\\['${uuid}'\\]/[]/" <<<"${enabled_extensions}")"
        gsettings set org.gnome.shell enabled-extensions "${filtered_extensions}" ||
          fail "could not remove conflicting ${name} from GNOME's enabled extension list"
      fi
    fi
  else
    printf 'warning: no GNOME user session bus; conflicting %s remains enabled\n' "${name}" >&2
  fi
}

remove_extension() {
  local uuid="$1"
  local name="$2"

  [[ -d "${extension_root}/${uuid}" ]] || return 0
  gnome-extensions uninstall "${uuid}" ||
    fail "could not remove ${name}; remove ${uuid} manually before running chezmoi apply again"
}

install_extension 'dash-to-dock@micxgx.gmail.com' 'Dash to Dock'
install_extension 'blur-my-shell@aunetx' 'Blur my Shell'
disable_extension 'appindicatorsupport@rgcjonas.gmail.com' 'AppIndicator and KStatusNotifierItem Support'
if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
  remove_extension 'appindicatorsupport@rgcjonas.gmail.com' 'AppIndicator and KStatusNotifierItem Support'
else
  printf 'warning: no GNOME user session bus; the third-party AppIndicator extension remains installed\n' >&2
fi
disable_extension 'ubuntu-appindicators@ubuntu.com' 'Ubuntu AppIndicators'
disable_extension 'ubuntu-dock@ubuntu.com' 'Ubuntu Dock' true
install_extension 'Vitals@CoreCoding.com' 'Vitals'
install_extension 'live-lockscreen@nick-redwill' 'Live Lock Screen'
{{- end }}
