{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/usr/bin/env bash
set -euo pipefail

font_family="FiraCode Nerd Font Mono"
font_name="${font_family} 13"

if ! command -v ptyxis >/dev/null 2>&1; then
  exit 0
fi

command -v fc-match >/dev/null 2>&1 || {
  printf 'Error: fc-match is unavailable; cannot verify the Developer font\n' >&2
  exit 1
}

resolved_font="$(fc-match -f '%{family[0]}\n' "${font_family}" 2>/dev/null || true)"
if [[ "${resolved_font}" != "${font_family}" ]]; then
  printf 'Error: %s is not available through fontconfig\n' "${font_family}" >&2
  exit 1
fi

if [[ "$(gsettings get org.gnome.Ptyxis use-system-font)" != "false" ]]; then
  gsettings set org.gnome.Ptyxis use-system-font false
fi

if [[ "$(gsettings get org.gnome.Ptyxis font-name)" != "'${font_name}'" ]]; then
  gsettings set org.gnome.Ptyxis font-name "${font_name}"
fi

profile_uuid="$(gsettings get org.gnome.Ptyxis default-profile-uuid | tr -d "'")"
[[ -n "${profile_uuid}" ]] || {
  printf 'Error: Ptyxis has no default profile UUID\n' >&2
  exit 1
}

profile_schema="org.gnome.Ptyxis.Profile:/org/gnome/Ptyxis/Profiles/${profile_uuid}/"
if [[ "$(gsettings get "${profile_schema}" palette)" != "'dracula'" ]]; then
  gsettings set "${profile_schema}" palette dracula
fi
{{- end }}
