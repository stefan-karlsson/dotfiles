# Show the Powerlevel10k prompt while the rest of Zsh finishes initializing.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Make user-installed command-line tools available in every Developer Shell.
# This file is templated from the managed Zsh plugin metadata.
if [[ ":${PATH:-}:" != *":$HOME/.local/bin:"* ]]; then
  export PATH="$HOME/.local/bin${PATH:+:$PATH}"
fi
if [[ ":${PATH:-}:" != *":$HOME/.dotnet/tools:"* ]]; then
  export PATH="$HOME/.dotnet/tools${PATH:+:$PATH}"
fi

dotnet_dev_cert_nssdb="${HOME}/.pki/nssdb"
if [[ -d "${dotnet_dev_cert_nssdb}" ]]; then
  export DOTNET_DEV_CERTS_NSSDB_PATHS="${dotnet_dev_cert_nssdb}"
fi
dotnet_dev_cert_trust_dir="${HOME}/.aspnet/dev-certs/trust"
if [[ -d "${dotnet_dev_cert_trust_dir}" ]]; then
  export SSL_CERT_DIR="${dotnet_dev_cert_trust_dir}:${SSL_CERT_DIR:-/usr/lib/ssl/certs}"
fi

ue_root="${XDG_DATA_HOME:-$HOME/.local/share}/unreal-engine/5.8"
if [[ -d "${ue_root}" ]]; then
  export UE_ROOT="${ue_root}"
fi

# Run the remaining configuration only in interactive shells.
[[ -o interactive ]] || return

# Use familiar Emacs-style line editing.
bindkey -e

if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi

# Keep command history private, shared between terminals, and free of duplicates.
HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

if [[ ! -e "$HISTFILE" ]]; then
  (umask 077 && : > "$HISTFILE")
fi
chmod 600 "$HISTFILE"

setopt append_history
setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_save_no_dups

# Cache completion metadata outside the managed source state.
zsh_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
mkdir -p "$zsh_cache_dir"

if (( $+commands[aws_completer] )); then
  autoload -Uz bashcompinit
  bashcompinit
  complete -C "$(command -v aws_completer)" aws
fi

autoload -Uz compinit
compinit -d "$zsh_cache_dir/zcompdump"

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

zsh_plugin_root="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"
zsh_plugin_source() {
  local plugin_name="$1"
  local source_file="$2"
  local plugin_path="${zsh_plugin_root}/${plugin_name}/${source_file}"

  if [[ -r "${plugin_path}" ]]; then
    source "${plugin_path}"
  else
    printf 'warning: managed Zsh plugin is unavailable: %s\n' "${plugin_name}" >&2
  fi
}

typeset -g ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
typeset -ga ZSH_AUTOSUGGEST_STRATEGY=(history completion)
{{ range .zsh_plugins.plugins }}
{{ if eq .load_phase "after-completion" }}zsh_plugin_source {{ .name | quote }} {{ .source_file | quote }}{{ end }}
{{ end }}

# Powerlevel10k is installed by chezmoi and configured by ~/.p10k.zsh.
typeset -g POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true
p10k_theme_dir="${XDG_DATA_HOME:-$HOME/.local/share}/powerlevel10k"
if [[ -r "${p10k_theme_dir}/powerlevel10k.zsh-theme" ]]; then
  source "${p10k_theme_dir}/powerlevel10k.zsh-theme"
  [[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
fi

# Enable optional developer tools only when available on the current platform.
if (( $+commands[fzf] && $+commands[rg] )); then
  export FZF_DEFAULT_COMMAND='rg --files --glob "!.git/*"'
  export FZF_DEFAULT_OPTS='--color=fg:#f8f8f2,bg:#282a36,hl:#bd93f9 --color=fg+:#f8f8f2,bg+:#44475a,hl+:#bd93f9 --color=info:#ffb86c,prompt:#50fa7b,pointer:#ff79c6 --color=marker:#ff79c6,spinner:#ffb86c,header:#6272a4'
  eval "$(fzf --zsh)"
fi

# Use the free Dracula palette for command-line tools that expose color settings.
export EZA_COLORS='uu=36:uR=31:un=35:gu=37:da=2;34:ur=34:uw=95:ux=36:ue=36:gr=34:gw=35:gx=36:tr=34:tw=35:tx=36:xx=95'
export RIPGREP_CONFIG_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/ripgrep/config"

if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# Keep Kubernetes workflow helpers explicit and local: these commands read or
# update the user's own kubeconfig, but chezmoi never edits that file.
if (( $+commands[kubectl] )); then
  alias k='kubectl'
  source <(kubectl completion zsh)
  (( $+functions[_kubectl] )) && compdef _kubectl k
fi

if (( $+commands[helm] )); then
  source <(helm completion zsh)
fi

if (( $+commands[just] )); then
  source <(just --completions zsh)
fi

if (( $+commands[slay] )); then
  source <(slay completions zsh 2>/dev/null)
fi

# Grafana CLI completion only. Grafana instances, API tokens, and the stacks gcx
# is logged in to stay user-owned and unmanaged.
if (( $+commands[gcx] )); then
  source <(gcx completion zsh)
fi

if (( $+commands[kubectx] )); then
  alias kx='kubectx'
fi

if (( $+commands[kubens] )); then
  alias kn='kubens'
fi

{{ range .zsh_plugins.plugins }}
{{ if eq .load_phase "after-kubernetes" }}zsh_plugin_source {{ .name | quote }} {{ .source_file | quote }}{{ end }}
{{ end }}

if (( ! $+commands[bat] && $+commands[batcat] )); then
  alias bat='batcat'
fi

if (( $+commands[eza] )); then
  alias l='eza --group-directories-first --classify'
  alias la='eza --all --group-directories-first --classify'
  alias ll='eza --all --long --header --git --group-directories-first --classify'
fi

# Walking up the tree by dots: .. is one level, ... is two, on to ...... for five.
# Only the first word of a command line is alias-expanded, so ../.. inside a path
# argument keeps its ordinary meaning.
zsh_define_parent_alias() {
  local alias_name="$1"
  local parent_path="$2"

  if (( ! $+aliases[${alias_name}] && ! $+functions[${alias_name}] )); then
    alias -- "${alias_name}=cd ${parent_path}"
  fi
}

zsh_parent_alias_name='..'
zsh_parent_alias_path='..'
zsh_define_parent_alias "${zsh_parent_alias_name}" "${zsh_parent_alias_path}"
repeat 4 do
  zsh_parent_alias_name+='.'
  zsh_parent_alias_path+='/..'
  zsh_define_parent_alias "${zsh_parent_alias_name}" "${zsh_parent_alias_path}"
done
unset zsh_parent_alias_name zsh_parent_alias_path

if (( $+commands[git] )); then
  if (( ! $+functions[git_current_branch] )); then
    git_current_branch() {
      git symbolic-ref --quiet --short HEAD 2>/dev/null
    }
  fi

  zsh_define_git_alias() {
    local alias_name="$1"
    local alias_value="$2"

    if (( ! $+aliases[${alias_name}] && ! $+functions[${alias_name}] )); then
      alias "${alias_name}=${alias_value}"
    fi
  }

  zsh_define_git_alias g 'git'
  zsh_define_git_alias ga 'git add'
  zsh_define_git_alias gaa 'git add --all'
  zsh_define_git_alias gco 'git checkout'
  zsh_define_git_alias gcb 'git checkout -b'
  zsh_define_git_alias gcmsg 'git commit --message'
  zsh_define_git_alias gd 'git diff'
  zsh_define_git_alias gl 'git pull'
  zsh_define_git_alias gp 'git push'
  zsh_define_git_alias gpsup 'git push --set-upstream origin "$(git_current_branch)"'
  zsh_define_git_alias gst 'git status'
fi

export YSU_MESSAGE_POSITION='before'
export YSU_MODE='BESTMATCH'
{{ range .zsh_plugins.plugins }}
{{ if eq .load_phase "after-git-aliases" }}zsh_plugin_source {{ .name | quote }} {{ .source_file | quote }}{{ end }}
{{ end }}

# zsh-syntax-highlighting must remain the final plugin sourced by this file.
{{ range .zsh_plugins.plugins }}
{{ if eq .load_phase "last" }}zsh_plugin_source {{ .name | quote }} {{ .source_file | quote }}{{ end }}
{{ end }}
