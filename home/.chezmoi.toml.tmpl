{{- $profile_choices := list "default" "private" "company" -}}
{{- $profile_name := promptChoiceOnce . "profile.name" "Which bootstrap profile should be active?" $profile_choices "default" -}}
{{- $profile_user_name_key := printf "profiles.%s.user.name" $profile_name -}}
{{- $profile_user_email_key := printf "profiles.%s.user.email" $profile_name -}}
{{- $user_name := promptStringOnce . $profile_user_name_key "Git author name" -}}
{{- $user_email := promptStringOnce . $profile_user_email_key "Git author email" -}}

[data.profile]
name = {{ $profile_name | quote }}

[data.profiles.{{ $profile_name }}.user]
name = {{ $user_name | quote }}
email = {{ $user_email | quote }}

[onepassword]
mode = "account"
prompt = true

[edit]
command = "code"
args = ["--wait"]

[diff]
command = "diff"
args = ["--unified"]

[merge]
command = "bash"
args = [
  "-c",
  {{ printf "%q" "cp {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}" }},
]
