{{- $profile_choices := list "default" "private" "company" -}}
{{- $profile_name := promptChoiceOnce . "profile.name" "Which bootstrap profile should be active?" $profile_choices "default" -}}
{{- $profile_user_name_key := printf "profiles.%s.user.name" $profile_name -}}
{{- $profile_user_email_key := printf "profiles.%s.user.email" $profile_name -}}
{{- $user_name := promptStringOnce . $profile_user_name_key "Git author name" -}}
{{- $user_email := promptStringOnce . $profile_user_email_key "Git author email" -}}
{{- /* The Huntress EDR agent belongs to the company profile overlay alone, so no
       other profile is asked for an account key it would never use. */ -}}
{{- $huntress_account_key := "" -}}
{{- if eq $profile_name "company" -}}
{{-   $profile_huntress_key := printf "profiles.%s.huntress.account_key" $profile_name -}}
{{-   $huntress_account_key = promptStringOnce . $profile_huntress_key "Huntress account key" -}}
{{- end -}}

[data.profile]
name = {{ $profile_name | quote }}

[data.profiles.{{ $profile_name }}.user]
name = {{ $user_name | quote }}
email = {{ $user_email | quote }}
{{ if eq $profile_name "company" }}
[data.profiles.{{ $profile_name }}.huntress]
account_key = {{ $huntress_account_key | quote }}
{{ end }}
[onepassword]
mode = "account"
prompt = true

[edit]
command = "code"
args = ["--wait"]

# No [diff] command: chezmoi's own diff is the only one that can describe every
# entry type it manages. An external file-comparison tool is handed /dev/null and
# the target path for an entry that does not exist yet, which it cannot represent
# for a directory — GNU diff then looks for a file named null inside it and stops
# the whole diff — and an editor invoked here would block the terminal.

[merge]
command = "bash"
args = [
  "-c",
  {{ printf "%q" "cp {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}" }},
]
