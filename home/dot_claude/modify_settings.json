{{- $settings = setValueAtPath (list "permissions" "deny") (concat (fromJson `[
  "Bash(sudo:*)",
  "Bash(su:*)",
  "Bash(shutdown:*)",
  "Bash(reboot:*)",
  "Bash(mkfs:*)",
  "Bash(snowsql:*)"
    ]`) (list
      (printf "Read(//%s/.ssh/**)" $home)
      (printf "Read(//%s/.aws/credentials)" $home)
      (printf "Read(//%s/.claude/.credentials.json)" $home))) $settings -}}
{{- $settings = setValueAtPath (list "skipDangerousModePermissionPrompt") true $settings -}}

{{- /* Plugins from public marketplaces, then the Qliro-internal ones from
       local data. Set key by key so a `false` toggle is not treated as empty,
       and so a plugin enabled only on this machine survives an apply. */ -}}
{{- $plugins := get $settings "enabledPlugins" | default (dict) -}}
{{- range $name, $enabled := (fromJson `{
      "arc42-toolkit@arc42-toolkit": true,
      "frontend-design@claude-plugins-official": true,
      "mattpocock-skills@claude-plugins-official": true
    }`) -}}
{{- $plugins = set $plugins $name $enabled -}}
{{- end -}}
{{- range $name, $enabled := (get $work "claude_plugins" | default (dict)) -}}
{{- $plugins = set $plugins $name $enabled -}}
{{- end -}}
{{- $settings = setValueAtPath (list "enabledPlugins") $plugins $settings -}}

{{- $marketplaces := get $settings "extraKnownMarketplaces" | default (dict) -}}
{{- $marketplaces = set $marketplaces "arc42-toolkit" (fromJson `{
      "source": { "source": "github", "repo": "MSiccDev/arc42-toolkit" }
    }`) -}}
{{- range $name, $definition := (get $work "claude_marketplaces" | default (dict)) -}}
{{- $marketplaces = set $marketplaces $name $definition -}}
{{- end -}}
{{- $settings = setValueAtPath (list "extraKnownMarketplaces") $marketplaces $settings -}}

{{- toPrettyJson "  " $settings | trimSuffix "\n" -}}
