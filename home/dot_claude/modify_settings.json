{{- /* chezmoi:modify-template */ -}}

{{- /* Claude Code and Orca rewrite this file while they run. Everything they
       add (hooks, statusLine, anything new) passes through untouched; this
       template owns only the preferences that should match on every machine.
       Qliro-internal plugin and marketplace entries come from the local
       chezmoi config, so no internal path reaches this public repository. */ -}}

{{- $settings := dict -}}
{{- /* .chezmoi.stdin is absent outside a modify run, such as under
       `chezmoi execute-template`, so it is looked up rather than indexed. */ -}}
{{- $stdin := get .chezmoi "stdin" | default "" -}}
{{- if not ($stdin | trim | empty) -}}
{{- $settings = fromJsonc $stdin -}}
{{- end -}}

{{- $profiles := get . "profiles" | default (dict) -}}
{{- $profile_name := get (get . "profile" | default (dict)) "name" | default "default" -}}
{{- $work := get (get $profiles $profile_name | default (dict)) "work" | default (dict) -}}

{{- /* Interface */ -}}
{{- $settings = setValueAtPath (list "theme") "dark" $settings -}}
{{- $settings = setValueAtPath (list "tui") "fullscreen" $settings -}}
{{- $settings = setValueAtPath (list "editorMode") "normal" $settings -}}
{{- $settings = setValueAtPath (list "verbose") true $settings -}}

{{- /* Model and effort */ -}}
{{- $settings = setValueAtPath (list "model") "claude-opus-5" $settings -}}
{{- $settings = setValueAtPath (list "effortLevel") "high" $settings -}}
{{- $settings = setValueAtPath (list "modelSettings") (fromJson `{
      "claude-fable-5": { "effortLevel": "high" },
      "claude-fable-5-1": { "effortLevel": "medium" },
      "claude-opus-5": { "effortLevel": "high" }
    }`) $settings -}}

{{- /* Permissions. The deny list guards the credential stores by absolute path. */ -}}
{{- $home := .chezmoi.homeDir | trimPrefix "/" -}}
{{- $settings = setValueAtPath (list "permissions" "defaultMode") "acceptEdits" $settings -}}
