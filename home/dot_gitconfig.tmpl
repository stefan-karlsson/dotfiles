{{- $legacy_user := get . "user" | default (dict) -}}
{{- $profiles := get . "profiles" | default (dict) -}}
{{- $profile_data := get . "profile" | default (dict) -}}
{{- $profile_name := get $profile_data "name" | default "default" -}}
{{- $selected_profile := get $profiles $profile_name | default (dict) -}}
{{- $selected_user := get $selected_profile "user" | default $legacy_user -}}
{{- $work := get $selected_profile "work" | default (dict) -}}
{{- $work_email := get $work "email" | default "" -}}
{{- $work_gitlab_host := get $work "gitlab_host" | default "" -}}
[user]
  name = {{ get $selected_user "name" | quote }}
  email = {{ get $selected_user "email" | quote }}

[init]
  defaultBranch = main

[color]
  ui = auto

[color "branch"]
  current = yellow
  local = yellow
  remote = green
  upstream = cyan
  plain = yellow

[color "diff"]
  meta = yellow
  frag = magenta
  old = red
  new = green
  commit = yellow

[color "status"]
  added = green
  changed = yellow
  untracked = red
  branch = cyan
  header = magenta
  nobranch = red

# Writes to GitHub are rewritten to SSH so they authenticate through the
# 1Password SSH agent, per ADR 0001, whatever remote a repository was cloned
# with. Reads deliberately stay on HTTPS: a clone or fetch then needs no key and
# no unlocked desktop app, which is what the bootstrap depends on before
# 1Password is set up. pushInsteadOf rather than insteadOf is what draws that
# line.
[url "git@github.com:"]
  pushInsteadOf = https://github.com/

[credential "https://github.com"]
  helper =
  helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !/usr/bin/gh auth git-credential
{{ if and (eq $profile_name "company") $work_gitlab_host }}
[credential "https://{{ $work_gitlab_host }}"]
  helper = !/usr/bin/glab auth git-credential
{{- end }}
{{- if and (eq $profile_name "company") $work_email }}

# Company repositories commit under the work address instead of the personal one
# above. This include must stay below [user]: git applies includes at the point
# they appear and later values win, so moving it above that section would
# silently do nothing.
[includeIf "gitdir:~/repos/gitlab/"]
  path = ~/.gitconfig-work
{{- end }}
