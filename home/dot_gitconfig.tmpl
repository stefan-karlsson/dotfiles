[user]
  name = {{ .user.name | quote }}
  email = {{ .user.email | quote }}

[init]
  defaultBranch = main

[color]
  ui = auto

[color "branch"]
  current = yellow
  local = yellow
  remote = green
  upstream = cyan
  plain = yellow

[color "diff"]
  meta = yellow
  frag = magenta
  old = red
  new = green
  commit = yellow

[color "status"]
  added = green
  changed = yellow
  untracked = red
  branch = cyan
  header = magenta
  nobranch = red

[credential "https://github.com"]
  helper =
  helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !/usr/bin/gh auth git-credential
