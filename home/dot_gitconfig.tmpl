{{- $legacy_user := get . "user" | default (dict) -}}
{{- $profiles := get . "profiles" | default (dict) -}}
{{- $profile_data := get . "profile" | default (dict) -}}
{{- $profile_name := get $profile_data "name" | default "default" -}}
{{- $selected_profile := get $profiles $profile_name | default (dict) -}}
{{- $selected_user := get $selected_profile "user" | default $legacy_user -}}
[user]
  name = {{ get $selected_user "name" | quote }}
  email = {{ get $selected_user "email" | quote }}

[init]
  defaultBranch = main

[color]
  ui = auto

[color "branch"]
  current = yellow
  local = yellow
  remote = green
  upstream = cyan
  plain = yellow

[color "diff"]
  meta = yellow
  frag = magenta
  old = red
  new = green
  commit = yellow

[color "status"]
  added = green
  changed = yellow
  untracked = red
  branch = cyan
  header = magenta
  nobranch = red

[credential "https://github.com"]
  helper =
  helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !/usr/bin/gh auth git-credential
