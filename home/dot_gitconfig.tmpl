{{- $legacy_user := get . "user" | default (dict) -}}
{{- $profiles := get . "profiles" | default (dict) -}}
{{- $profile_data := get . "profile" | default (dict) -}}
{{- $profile_name := get $profile_data "name" | default "default" -}}
{{- $selected_profile := get $profiles $profile_name | default (dict) -}}
{{- $selected_user := get $selected_profile "user" | default $legacy_user -}}
{{- $work := get $selected_profile "work" | default (dict) -}}
{{- $work_email := get $work "email" | default "" -}}
{{- $work_gitlab_host := get $work "gitlab_host" | default "" -}}
[user]
  name = {{ get $selected_user "name" | quote }}
  email = {{ get $selected_user "email" | quote }}

[init]
  defaultBranch = main

# Git refuses to pull divergent branches without being told how to reconcile
# them. ff-only keeps that refusal: divergence is information — a stray commit on
# main, or a force-pushed upstream — and rebasing or merging automatically hides
# the case worth looking at. Pick per pull with `git pull --rebase` or a merge.
# pull.ff is ignored when pull.rebase is set, so this file sets only the one.
[pull]
  ff = only

[fetch]
  prune = true

[rebase]
  autoStash = true
  autosquash = true
  updateRefs = true

[merge]
  conflictStyle = zdiff3

[color]
  ui = auto

[color "branch"]
  current = yellow
  local = yellow
  remote = green
  upstream = cyan
  plain = yellow

[color "diff"]
  meta = yellow
  frag = magenta
  old = red
  new = green
  commit = yellow

[color "status"]
  added = green
  changed = yellow
  untracked = red
  branch = cyan
  header = magenta
  nobranch = red

# Writes to GitHub go over SSH and authenticate through the 1Password SSH agent,
# per ADR 0001, whatever remote a repository was cloned with. Reads stay on HTTPS
# and need no key and no unlocked desktop app. pushInsteadOf draws that line;
# insteadOf would move reads too.
[url "git@github.com:"]
  pushInsteadOf = https://github.com/

[credential "https://github.com"]
  helper =
  helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !/usr/bin/gh auth git-credential
{{ if and (eq $profile_name "company") $work_gitlab_host }}
[credential "https://{{ $work_gitlab_host }}"]
  helper = !/usr/bin/glab auth git-credential
{{- end }}
{{- if and (eq $profile_name "company") $work_email }}

# Company repositories commit under the work address; [user] above carries the
# personal one. Git applies an include at the point it appears and the later value
# wins, so this include belongs below [user].
[includeIf "gitdir:~/repos/gitlab/"]
  path = ~/.gitconfig-work
{{- end }}
