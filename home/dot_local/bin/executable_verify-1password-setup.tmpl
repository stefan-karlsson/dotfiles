{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash

set -euo pipefail

github_check=false
onepassword_source_file="/etc/apt/sources.list.d/1password.list"
onepassword_marker_file="/var/lib/chezmoi/1password-stable"
onepassword_repository_uri="https://downloads.1password.com/linux/debian/amd64"
onepassword_key_file="/usr/share/keyrings/1password-archive-keyring.gpg"

usage() {
  printf 'usage: verify-1password-setup [--github]\n'
}

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

package_installed() {
  [[ "$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null || true)" == "installed" ]]
}

installed_package_available_from_onepassword_repository() {
  installed_version="$(dpkg-query -W -f='${Version}' "$1" 2>/dev/null || true)"
  [[ -n "${installed_version}" ]] || return 1
  apt-cache madison "$1" 2>/dev/null | awk -F '|' \
    -v installed_version="${installed_version}" \
    -v repository_uri="${onepassword_repository_uri}" '
      {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
        if ($2 == installed_version && index($3, repository_uri)) found = 1
      }
      END { exit !found }
    '
}

command_owned_by_package() {
  command_path="$(command -v "$1" 2>/dev/null)" || return 1
  package_owner="$(dpkg-query -S "${command_path}" 2>/dev/null || true)"
  package_owner="${package_owner%%:*}"
  [[ "${package_owner}" == "$2" ]]
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --github)
      github_check=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      fail "unknown argument: $1"
      ;;
  esac
  shift
done

package_installed 1password || fail "the managed 1password package is not installed"
package_installed 1password-cli || fail "the managed 1password-cli package is not installed"
[[ -f "$onepassword_marker_file" ]] || fail "the 1Password packages are not managed by chezmoi"
onepassword_source="deb [arch=amd64 signed-by=${onepassword_key_file}] ${onepassword_repository_uri} stable main"
existing_onepassword_source="$(cat "$onepassword_source_file" 2>/dev/null || true)"
[[ "$existing_onepassword_source" == "$onepassword_source" || "$existing_onepassword_source" == "# $onepassword_source" ]] || {
  fail "the configured 1Password apt repository is not the managed stable repository"
}
installed_package_available_from_onepassword_repository 1password || {
  fail "the installed 1password version is unavailable from the official stable repository"
}
installed_package_available_from_onepassword_repository 1password-cli || {
  fail "the installed 1password-cli version is unavailable from the official stable repository"
}
command_owned_by_package 1password 1password || fail "the 1Password desktop command is not owned by the managed package"
command_owned_by_package op 1password-cli || fail "the 1Password CLI command is not owned by the managed package"

op vault list >/dev/null || fail "1Password CLI access failed; sign in to the desktop app and enable CLI integration"
printf '1Password CLI access is working.\n'

agent_socket="$HOME/.1password/agent.sock"
[[ -S "$agent_socket" ]] || fail "the 1Password SSH agent socket is unavailable; enable the SSH agent in 1Password"
printf '1Password SSH agent socket is available.\n'

if [[ "$github_check" == true ]]; then
  set +e
  github_output="$(ssh -T git@github.com 2>&1)"
  github_status=$?
  set -e

  if [[ $github_status -ne 1 || "$github_output" != *"successfully authenticated"* ]]; then
    printf '%s\n' "$github_output" >&2
    fail "GitHub SSH authentication failed"
  fi
  printf 'GitHub SSH authentication is working.\n'
fi
{{- end }}
