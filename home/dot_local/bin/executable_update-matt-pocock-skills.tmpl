#!/usr/bin/env bash

set -euo pipefail

export DISABLE_TELEMETRY=1

skill_args=()
{{- range .skills.matt_pocock.names }}
skill_args+=(--skill {{ . | quote }})
{{- end }}

run_npx() {
  if declare -F npx >/dev/null 2>&1; then
    npx "$@"
  elif command -v mise >/dev/null 2>&1; then
    mise exec -- npx "$@"
  else
    npx "$@"
  fi
}

run_npx --yes skills@latest add {{ .skills.matt_pocock.source | quote }} \
  --global \
  --agent {{ .skills.matt_pocock.agent | quote }} \
  --yes \
  "${skill_args[@]}"

for skill in {{ range .skills.matt_pocock.names }}{{ . | quote }} {{ end }}; do
  canonical_path="$HOME/.agents/skills/$skill"

  [[ -d "$canonical_path" ]] || {
    printf 'error: expected installed skill at %s\n' "$canonical_path" >&2
    printf 'the upstream collection installs what it still publishes and skips the rest, so check whether %s was renamed or removed\n' \
      "$skill" >&2
    exit 1
  }
done

# ~/.agents/skills is canonical. Each agent discovers skills only under its own
# skills directory, so every skill is symlinked into each of them.
for link_dir in {{ range .skills.matt_pocock.link_dirs }}{{ . | quote }} {{ end }}; do
  mkdir -p "$HOME/$link_dir"

  for skill in {{ range .skills.matt_pocock.names }}{{ . | quote }} {{ end }}; do
    agent_path="$HOME/$link_dir/$skill"

    rm -rf "$agent_path"
    ln -s "$HOME/.agents/skills/$skill" "$agent_path"
  done
done
