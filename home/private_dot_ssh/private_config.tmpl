Host github.com
  HostName github.com
  User git
  StrictHostKeyChecking yes
  UpdateHostKeys no
{{- if stat (joinPath .chezmoi.homeDir ".1password/agent.sock") }}
  IdentityAgent ~/.1password/agent.sock
{{- else }}
  IdentityFile ~/.ssh/id_ed25519
  AddKeysToAgent yes
  {{/* IdentitiesOnly restricts ssh to the identity files this configuration
       names, or to the default ones when it names none, even when an agent
       offers more. It belongs with the local key it is meant to pin: paired with
       IdentityAgent and no IdentityFile it pins nothing that exists and hides
       the agent's key, so GitHub answers publickey-denied while 1Password is
       unlocked and holding it. */ -}}
  IdentitiesOnly yes
{{- end }}
