Host github.com
  HostName github.com
  User git
  StrictHostKeyChecking yes
  UpdateHostKeys no
{{- if stat (joinPath .chezmoi.homeDir ".1password/agent.sock") }}
  IdentityAgent ~/.1password/agent.sock
{{- else }}
  IdentityFile ~/.ssh/id_ed25519
  AddKeysToAgent yes
{{- end }}
  IdentitiesOnly yes
