{{- $profiles := get . "profiles" | default (dict) -}}
{{- $profile_data := get . "profile" | default (dict) -}}
{{- $profile_name := get $profile_data "name" | default "default" -}}
{{- $selected_profile := get $profiles $profile_name | default (dict) -}}
{{- $work := get $selected_profile "work" | default (dict) -}}
{{- $work_email := get $work "email" | default "" -}}
{{- /* The work identity is the company profile's alone. Rendering nothing on any
       other profile removes the file rather than leaving an empty one behind:
       chezmoi deletes a target whose template renders empty unless the source is
       marked empty_. */ -}}
{{- if and (eq $profile_name "company") $work_email -}}
; Work identity for company repositories.
; Applied to anything under ~/repos/gitlab/ by the includeIf in ~/.gitconfig.
; The address is prompted for once and held in the machine-local configuration.
[user]
  email = {{ $work_email | quote }}
{{ end -}}
